$ORIGIN example.com.
$TTL 3600
@   IN SOA ns1.example.com. admin.example.com. (
        2026060301 ; serial
        7200       ; refresh
        3600       ; retry
        1209600    ; expire
        3600 )     ; minimum
@       IN NS  ns1.example.com.
@       IN A   192.0.2.1
ns1     IN A   192.0.2.1
www     IN A   192.0.2.2
