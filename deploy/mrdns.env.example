# Secrets for mrdns, loaded by systemd via EnvironmentFile.
# Installed location: /opt/mrdns/etc/mrdns.env  (mode 0640, group mrdns)
#
# Generate strong values:
#   MRDNS_TOKEN:      openssl rand -hex 32
#   MRDNS_COOKIE_KEY: openssl rand -hex 32   (>= 32 bytes / 64 hex chars)

MRDNS_TOKEN=change-me-to-a-long-random-token
MRDNS_COOKIE_KEY=change-me-to-64-hex-characters-minimum
